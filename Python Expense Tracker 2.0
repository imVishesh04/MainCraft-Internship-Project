import csv
import os
from datetime import datetime

FILE_NAME = "expenses.csv"

# Ensure CSV exists with headers
if not os.path.exists(FILE_NAME):
    with open(FILE_NAME, mode="w", newline="") as file:
        writer = csv.writer(file)
        writer.writerow(["Date", "Description", "Amount", "Category"])

def add_expense():
    description = input("Enter description: ")
    amount = float(input("Enter amount: "))
    category = input("Enter category (Food/Travel/Shopping/etc.): ")
    date = datetime.now().strftime("%Y-%m-%d")
    
    with open(FILE_NAME, mode="a", newline="") as file:
        writer = csv.writer(file)
        writer.writerow([date, description, amount, category])
    print("Expense added successfully!\n")

def search_by_category():
    category = input("Enter category to search: ").strip().lower()
    found = False
    
    with open(FILE_NAME, mode="r") as file:
        reader = csv.DictReader(file)
        print(f"\nExpenses in category '{category}':")
        for row in reader:
            if row["Category"].lower() == category:
                print(f"{row['Date']} | {row['Description']} | ₹{row['Amount']}")
                found = True
    if not found:
        print("No expenses found in this category.\n")

def total_spent_per_category():
    totals = {}
    with open(FILE_NAME, mode="r") as file:
        reader = csv.DictReader(file)
        for row in reader:
            cat = row["Category"]
            totals[cat] = totals.get(cat, 0) + float(row["Amount"])
    print("\nTotal spent per category:")
    for cat, total in totals.items():
        print(f"{cat}: ₹{total}")
    print()

def monthly_spending():
    current_month = datetime.now().strftime("%Y-%m")
    total = 0
    with open(FILE_NAME, mode="r") as file:
        reader = csv.DictReader(file)
        for row in reader:
            if row["Date"].startswith(current_month):
                total += float(row["Amount"])
    print(f"\nTotal spending this month ({current_month}): ₹{total}\n")

def menu():
    while True:
        print("=== Expense Tracker 2.0 ===")
        print("1. Add Expense")
        print("2. Search by Category")
        print("3. Total Spent per Category")
        print("4. Monthly Spending")
        print("5. Exit")
        
        choice = input("Enter choice: ")
        if choice == "1":
            add_expense()
        elif choice == "2":
            search_by_category()
        elif choice == "3":
            total_spent_per_category()
        elif choice == "4":
            monthly_spending()
        elif choice == "5":
            print("Exiting... Goodbye!")
            break
        else:
            print("Invalid choice! Try again.\n")

# Run the menu
menu()
